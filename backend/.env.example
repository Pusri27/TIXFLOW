# ==============================================================================
# TIXFLOW Backend Environment Variables (100% Free-Tier Services)
# Set these in Render Dashboard -> Environment (or local .env)
# ==============================================================================

PORT=8080

# Neon Serverless PostgreSQL (Free Tier)
DB_URL=jdbc:postgresql://your-neon-host.aws.neon.tech/neondb?sslmode=require&connectTimeout=10
DB_USER=neondb_owner
DB_PASS=your_neon_password

# Upstash Redis (Free Tier — optional, falls back gracefully if omitted)
SPRING_REDIS_HOST=your-upstash-endpoint.upstash.io
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=your_upstash_password

# Security (JWT)
JWT_SECRET=replace-with-a-secure-64-char-hex-secret

# Cloudinary (Free Tier — PDF E-Ticket storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Sandbox (Free Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend URL on Vercel (used for Stripe Checkout success/cancel redirect)
APP_FRONTEND_URL=https://your-tixflow-frontend.vercel.app
